---
// Light/dark toggle. Wired by THEME_SCRIPT (aria-pressed is "true" when dark); hidden without JS.
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  aria-label={label}
>
  <svg
    class="icon icon-moon"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
  </svg>
  <svg
    class="icon icon-sun"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4.5"></circle>
    <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .theme-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .theme-toggle:active {
    transform: scale(0.94);
  }
  .icon {
    grid-area: 1 / 1;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Shows the theme you switch to: moon in light mode, sun in dark mode. */
  .icon-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }
  /* Without JavaScript the toggle cannot work, so hide it (the page still follows the system). */
  :global(:root:not([data-theme])) .theme-toggle {
    display: none;
  }
</style>
