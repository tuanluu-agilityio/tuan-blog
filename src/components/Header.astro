---
import { localizedPath, t } from '../i18n/utils';
import type { Locale } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  alternateHref?: string;
}

const { locale, alternateHref } = Astro.props;
const norm = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const current = norm(Astro.url.pathname);
const home = localizedPath(locale, '/');
const items = [
  { href: home, label: t(locale, 'nav.home') },
  { href: localizedPath(locale, 'about'), label: t(locale, 'nav.about') },
].map((i) => ({ ...i, current: norm(i.href) === current }));
---

<header class="site-header">
  <a class="site-title" href={home}>
    {t(locale, 'site.title')}
  </a>
  <nav aria-label={t(locale, 'nav.label')}>
    <ul>
      {items.map((i) => (
        <li>
          <a href={i.href} aria-current={i.current ? 'page' : undefined}>
            {i.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="tools">
    <LanguageSwitcher locale={locale} alternateHref={alternateHref} />
    <ThemeToggle label={t(locale, 'theme.toggle')} />
  </div>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    max-inline-size: 60rem;
    margin-inline: auto;
    padding: var(--space-4);
    border-block-end: 1px solid var(--color-border);
  }
  .site-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
  }
  nav {
    order: 3;
    flex-basis: 100%;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    margin: 0;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-block-end: 2px solid transparent;
  }
  nav a:hover {
    color: var(--color-text);
  }
  nav a[aria-current='page'] {
    color: var(--color-text);
    border-block-end-color: var(--color-accent);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  @media (min-width: 40rem) {
    nav {
      order: 0;
      flex-basis: auto;
      margin-inline-start: auto;
    }
  }
</style>
